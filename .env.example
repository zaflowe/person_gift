DATABASE_URL=postgresql://app:changeme_in_production@db:5432/person_gift
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=person_gift

JWT_SECRET=your_random_secret_key_here_at_least_32_characters
TIMEZONE=Asia/Shanghai
ALLOWED_ORIGINS=https://yourdomain.com

# Personal telemetry: use two different random values.
# TELEMETRY_INGEST_KEY goes on iPhone Shortcuts / collectors (write only).
# TELEMETRY_AGENT_KEY is for GPT/admin access (read + semantic writes).
TELEMETRY_INGEST_KEY=replace_with_random_ingest_key
TELEMETRY_AGENT_KEY=replace_with_random_agent_key

# Comma-separated public MCP hosts/origins; DNS rebinding protection stays on.
# Example: telemetry.example.com,telemetry.example.com:443
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Optional server-side contextual interpretation. Never put this key on devices.
TELEMETRY_ENRICHMENT_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Only needed if the MCP adapter ever runs outside the backend container.
# TELEMETRY_BASE_URL=http://127.0.0.1:8000

AI_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

GEMINI_API_KEY=

NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_BASE=/api
